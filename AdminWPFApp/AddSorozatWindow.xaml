<Window x:Class="AdminWPFApp.AddSorozatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdminWPFApp"
        mc:Ignorable="d"
        Title="Új Sorozat Hozzáadása" Height="450" Width="400" Background="#F4F4F4">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="BorderBrush" Value="#B4B4B4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#A8D08D" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="200" />
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Text="Cím:"/>
                <TextBox x:Name="CimTextBox"/>

                <TextBlock Text="Leírás:"/>
                <TextBox x:Name="LeirasTextBox"/>

                <TextBlock Text="Megjelenési Dátum (YYYY-MM-DD):"/>
                <TextBox x:Name="MegjelenesiDatumTextBox"/>

                <TextBlock Text="Műfaj:"/>
                <TextBox x:Name="MufajTextBox"/>

                <TextBlock Text="Rendező:"/>
                <TextBox x:Name="RendezoTextBox"/>

                <TextBlock Text="Szereplők:"/>
                <TextBox x:Name="SzereplokTextBox"/>

                <TextBlock Text="Értékelés (1-5 között):"/>
                <TextBox x:Name="ErtekelesTextBox"/>

                <TextBlock Text="Sorozat URL:"/>
                <TextBox x:Name="SorozatUrlTextBox"/>

                <TextBlock Text="Évadok száma:"/>
                <TextBox x:Name="EvadokSzamaTextBox"/>

                <Button Content="Sorozat hozzáadása" Click="AddSorozat_Click" Margin="10"/>

            </StackPanel>
        </ScrollViewer>
       </Grid>
</Window>
