<Window x:Class="AdminWPFApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdminWPFApp"
        mc:Ignorable="d"
        Title="Admin Felület" Height="650" Width="800" Background="#F4F4F4">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0.5"/>
            <Setter Property="Background" Value="#f5f5f5"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Background" Value="#f5f5f5"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        
        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Background" Value="#9FE2BF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>

        
        <Style TargetType="TabControl">
            <Setter Property="Margin" Value="20"/>
        </Style>

        
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#f0f0f0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Grid">
            <Setter Property="Margin" Value="10"/>
        </Style>
    </Window.Resources>
    <Grid>
        <TabControl>
            <TabItem Header="Regisztráció">
                <StackPanel Margin="20">
                    <TextBlock Text="Teljes Név:" />
                    <TextBox Name="FullNameTextBox" Margin="0,5" />
                    <TextBlock Text="Felhasználónév:" />
                    <TextBox Name="UsernameTextBox" Margin="0,5" />
                    <TextBlock Text="E-mail cím:" />
                    <TextBox Name="EmailTextBox" Margin="0,5" />
                    <TextBlock Text="Jelszó:" />
                    <PasswordBox Name="PasswordBox" Margin="0,5" />
                    <TextBlock Text="Jelszó megerősítése:" />
                    <PasswordBox Name="ConfirmPasswordBox" Margin="0,5" />
                    <Button Name="RegisterButton" Content="Regisztráció" Margin="0,10" Click="RegisterButton_Click" />
                </StackPanel>
            </TabItem>


            <TabItem Header="Bejelentkezés">
                <StackPanel Margin="20">
                    <TextBlock Text="Felhasználónév:" />
                    <TextBox Name="LoginUsernameTextBox" Margin="0,5" />
                    <TextBlock Text="Jelszó:" />
                    <PasswordBox Name="LoginPasswordBox" Margin="0,5" />
                    <Button Name="LoginButton" Content="Bejelentkezés" Margin="0,10" Click="LoginButton_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
