<Window x:Class="AdminWPFApp.DeleteFilmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdminWPFApp"
        mc:Ignorable="d"
        Title="Film törlése" Height="450" Width="600">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFDD4C4C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </Window.Resources>
    <Grid Background="#F4F4F4">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="FilmsDataGrid" AutoGenerateColumns="False" Margin="10" CanUserAddRows="False" SelectionMode="Single" Grid.Row="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Film ID" Binding="{Binding FilmId}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Cím" Binding="{Binding Cim}" Width="*"/>
                <DataGridTextColumn Header="Műfaj" Binding="{Binding Mufaj}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Film törlése" VerticalAlignment="Bottom" Margin="10" Width="150" Click="DeleteFilmButton_Click" Grid.Row="1"/>
    </Grid>
</Window>
